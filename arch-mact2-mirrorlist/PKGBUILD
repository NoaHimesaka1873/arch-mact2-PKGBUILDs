pkgname=arch-mact2-mirrorlist
pkgver=3
pkgrel=1
pkgdesc="t2linux Arch Linux repository mirrorlist"
arch=('any')
url=https://github.com/NoaHimesaka1873/arch-mact2-utils-PKGBUILDs/tree/senpai/$pkgname
_url="https://raw.githubusercontent.com/NoaHimesaka1873/arch-mact2-utils-PKGBUILDs/senpai/$pkgname"

license=('GPL3')
options=(!strip !emptydirs)
backup=("etc/pacman.d/$pkgname")  # keeps the possibly ranked mirrorlist

source=($_url/$pkgname)
sha512sums=('8cb077cbc8e43d80b18b50184af95f4d31e0ff07b4117a1af6a47f0fea299c1d2f6482bc96c70e051bac55a675c0deea33b63f8af86e17a7a29074e9f01c4c93')

package() {
 install -Dm644 "$srcdir/$pkgname" "$pkgdir/etc/pacman.d/$pkgname"
}
