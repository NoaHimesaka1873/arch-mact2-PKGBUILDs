# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ <turanull000@gmail.com>

pkgname=t2-kernel-builder-git
pkgver=0.03.r14.c23ede9
pkgrel=1
pkgdesc="Kernel compilation and packaging utility for Apple T2 Macs"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit' 'kait2en-assets' 'kmod' 'base-devel' 'bc' 'cpio' 'curl' 'rsync')
makedepends=('git')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')
provides=('t2-kernel-builder')
conflicts=('t2-kernel-builder')

pkgver() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-kernel-builder"
    local ver=$(sed -n 's/^[[:space:]]*APP_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$src/t2-kernel-builder.py" | head -n1)
    printf "%s.r%s.%s" "${ver:-0.03}" "$(git -C "$src" rev-list --count HEAD -- .)" "$(git -C "$src" log -1 --format="%h" -- .)"
}

prepare() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-kernel-builder"

    # Fix branding asset path from /usr/local/share to /usr/share
    sed -i 's|/usr/local/share/kait2en|/usr/share/kait2en|g' "$src/t2-kernel-builder.py"

    # Fix engine and cleanup helper paths from /usr/local/libexec to /usr/lib/t2-kernel-builder
    sed -i 's|/usr/local/libexec/t2-kernel-builder-cleanup|/usr/lib/t2-kernel-builder/t2-kernel-builder-cleanup|g' \
        "$src/t2-kernel-builder.py" \
        "$src/org.t2kernelbuilder.gtk.policy" \
        "$src/engine/build.sh"

    sed -i 's|/usr/local/libexec/t2-kernel-builder|/usr/lib/t2-kernel-builder|g' "$src/t2-kernel-builder.py"

    # Fix desktop Exec/TryExec paths
    sed -i 's|/usr/local/bin/t2-kernel-builder|/usr/bin/t2-kernel-builder|g' "$src/org.t2kernelbuilder.gtk.desktop"
}

package() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-kernel-builder"
    install -d -m0755 "$pkgdir/usr/bin" \
                      "$pkgdir/usr/lib/t2-kernel-builder/configs" \
                      "$pkgdir/usr/share/applications" \
                      "$pkgdir/usr/share/icons/hicolor/scalable/apps" \
                      "$pkgdir/usr/share/polkit-1/actions"

    install -m0755 "$src/t2-kernel-builder.py" "$pkgdir/usr/bin/t2-kernel-builder"
    install -m0755 "$src/t2-kernel-builder-cleanup" "$pkgdir/usr/lib/t2-kernel-builder/t2-kernel-builder-cleanup"
    install -m0755 "$src/engine/build.sh" "$pkgdir/usr/lib/t2-kernel-builder/build.sh"

    find "$src/engine/configs" -maxdepth 1 -type f -name '*.config' \
        -exec install -m0644 '{}' "$pkgdir/usr/lib/t2-kernel-builder/configs/" \;

    install -m0644 "$src/org.t2kernelbuilder.gtk.desktop" "$pkgdir/usr/share/applications/org.t2kernelbuilder.gtk.desktop"
    install -m0644 "$src/org.t2kernelbuilder.gtk.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.t2kernelbuilder.gtk.svg"
    install -m0644 "$src/org.t2kernelbuilder.gtk.policy" "$pkgdir/usr/share/polkit-1/actions/org.t2kernelbuilder.gtk.policy"

    install -Dm0644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
