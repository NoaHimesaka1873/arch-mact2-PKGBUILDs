post_install() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if systemctl is-enabled --quiet t2-cpu-control-status.service 2>/dev/null; then
            systemctl disable --now t2-cpu-control-status.service
        elif systemctl is-active --quiet t2-cpu-control-status.service 2>/dev/null; then
            systemctl stop t2-cpu-control-status.service
        fi
        systemctl enable --now t2-cpu-control.service
    fi
}

post_upgrade() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl reset-failed t2-cpu-control.service 2>/dev/null || true
        systemctl try-restart t2-cpu-control.service
    fi
}

pre_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl disable --now t2-cpu-control.service
    fi
}
