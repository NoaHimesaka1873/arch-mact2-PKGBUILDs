pre_install() {
    rm -f /usr/share/alsa/ucm2/AppleT2/HiFi.conf /usr/share/alsa/ucm2/AppleT2/Measurement-x4.conf
}

pre_upgrade() {
    rm -f /usr/share/alsa/ucm2/AppleT2/HiFi.conf /usr/share/alsa/ucm2/AppleT2/Measurement-x4.conf
}

post_install() {
    echo "t2-ucm-conf: ALSA UCM profiles installed. If upgrading from legacy UCM, consider restarting user audio or checking 'wpctl status'."
}
