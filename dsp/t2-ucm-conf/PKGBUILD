# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ <turanull000@gmail.com>

pkgname=t2-ucm-conf
pkgver=r4.0ee536b
pkgrel=1
pkgdesc="ALSA UCM profiles for Apple T2 audio"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
optdepends=('linux' 'linux-headers')
depends=('t2bce-dkms' 'alsa-ucm-conf')
makedepends=('git')
conflicts=('linux-t2')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')
install="$pkgname.install"

pkgver() {
    local mod=modules/t2bce_audio-alsa-ucm-conf
    printf "r%s.%s" "$(git -C "$srcdir/KaiT2en-Fedora" rev-list --count HEAD -- $mod)" "$(git -C "$srcdir/KaiT2en-Fedora" log -1 --format="%h" -- $mod)"
}

package() {
    local src="$srcdir/KaiT2en-Fedora/modules/t2bce_audio-alsa-ucm-conf"

    install -d -m0755 "$pkgdir/usr/share/alsa/ucm2/AppleT2"
    local profile
    for profile in HiFi-x2 HiFi-x4 HiFi-x6; do
        [[ -f "$src/ucm2/AppleT2/$profile.conf" ]] || continue
        install -m0644 "$src/ucm2/AppleT2/$profile.conf" "$pkgdir/usr/share/alsa/ucm2/AppleT2/$profile.conf"
    done

    local driver
    for driver in AppleT2x2 AppleT2x4 AppleT2x6; do
        [[ -f "$src/ucm2/conf.d/$driver/$driver.conf" ]] || continue
        install -d -m0755 "$pkgdir/usr/share/alsa/ucm2/conf.d/$driver"
        install -m0644 "$src/ucm2/conf.d/$driver/$driver.conf" "$pkgdir/usr/share/alsa/ucm2/conf.d/$driver/$driver.conf"
    done

    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
