pkgname=t2archinstall
pkgrel=1
pkgver=1
pkgdesc="Arch Linux Installer TUI for Intel Macs with the T2 Security Chip"
url="https://github.com/slsrepo/t2archinstall"
arch=('x86_64')
license=('Apache-2.0')
makedepends=('git' 'python')
depends=('python-textual')
conflicts=('t2fand')
replaces=('t2fand')
source=('t2archinstall')
sha256sums=('SKIP')

package() {
  # Install binary
  install -Dm755 "t2archinstall" "$pkgdir/usr/bin/t2archinstall"
}
