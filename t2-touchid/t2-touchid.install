_enable_pam() {
    local pam_file=/etc/pam.d/system-local-login
    local begin='# t2-touchid: begin'
    local end='# t2-touchid: end'
    local rule='auth      sufficient pam_fprintd.so timeout=5 max-tries=1'

    [ -f "$pam_file" ] || return 0
    grep -Fxq "$begin" "$pam_file" && return 0
    grep -Eq '^[[:space:]]*auth[[:space:]]+.*pam_fprintd\.so([[:space:]]|$)' "$pam_file" && return 0
    grep -Eq '^[[:space:]]*auth[[:space:]]+include[[:space:]]+system-login[[:space:]]*$' "$pam_file" || return 0

    sed -i -E \
        "/^[[:space:]]*auth[[:space:]]+include[[:space:]]+system-login[[:space:]]*$/i\\
${begin}\\
${rule}\\
${end}" \
        "$pam_file"
}

_disable_pam() {
    local pam_file=/etc/pam.d/system-local-login
    [ -f "$pam_file" ] || return 0
    sed -i '/^# t2-touchid: begin$/,/^# t2-touchid: end$/d' "$pam_file"
}

post_install() {
    _enable_pam

    echo
    echo "t2-touchid has been installed successfully!"
    echo "Set T2_TOUCHID_BIND_USER in /etc/kait2en/t2-touchid.conf if you want automatic binding."
    echo "Then enable the service with:"
    echo
    echo "  sudo systemctl enable --now kait2en-t2-touchid.service"
    echo
}

post_upgrade() {
    _enable_pam

    if systemctl is-active --quiet kait2en-t2-touchid.service 2>/dev/null; then
        systemctl restart t2-touchid-network-setup.service >/dev/null 2>&1 || true
        systemctl restart kait2en-t2-touchid.service >/dev/null 2>&1 || true
    fi
}

pre_remove() {
    _disable_pam
    systemctl disable --now kait2en-t2-touchid.service >/dev/null 2>&1 || true
}
