[Unit]
Description=Prepare Apple T2 CDC-NCM link for Touch ID
Wants=NetworkManager.service
After=NetworkManager.service
Before=NetworkManager-wait-online.service network-online.target kait2en-t2-touchid.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/t2-touchid/network-setup
RemainAfterExit=yes
