# Maintainer: Sl (Shahaf Levi) <arch@slsrepo.com>

pkgname=t2-touchid
pkgver=0.1.1
pkgrel=1
pkgdesc="Apple T2 Touch ID bridge for fprintd"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=(
  'fprintd'
  'libfprint'
  'networkmanager'
)
makedepends=('cargo' 'git')
install="${pkgname}.install"

_source_dir=KaiT2en-Fedora

source=(
  "${_source_dir}::git+https://github.com/kaiT2en/KaiT2en-Fedora.git#main"
  't2-touchid-network-setup'
  't2-touchid-network-setup.service'
  '10-network-setup.conf'
  't2-touchid.nmconnection'
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

pkgver() {
  cd "$_source_dir"

  printf '0.1.0.r%s.g%s' \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "${_source_dir}/t2-services/t2-touchid"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch --locked
}

build() {
  cd "${_source_dir}/t2-services/t2-touchid"
  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_NET_OFFLINE=true
  make build CARGO_FLAGS='--frozen'
}

check() {
  cd "${_source_dir}/t2-services/t2-touchid"
  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_NET_OFFLINE=true
  make test CARGO_FLAGS='--frozen'
}

package() {
  cd "${_source_dir}"

  make -C t2-services/t2-touchid install \
    PREFIX=/usr \
    DESTDIR="${pkgdir}" \
    SYSTEMD_UNIT_DIR=/usr/lib/systemd/system \
    DATADIR=/usr/share \
    SYSCONFDIR=/usr/share

  install -Dm0755 "${srcdir}/t2-touchid-network-setup" \
    "${pkgdir}/usr/libexec/t2-touchid/network-setup"

  install -Dm0644 "${srcdir}/t2-touchid-network-setup.service" \
    "${pkgdir}/usr/lib/systemd/system/t2-touchid-network-setup.service"

  install -Dm0644 "${srcdir}/10-network-setup.conf" \
    "${pkgdir}/usr/lib/systemd/system/kait2en-t2-touchid.service.d/10-network-setup.conf"

  install -Dm0600 "${srcdir}/t2-touchid.nmconnection" \
    "${pkgdir}/usr/lib/NetworkManager/system-connections/t2-touchid.nmconnection"

  install -Dm0644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -Dm0644 t2-services/t2-touchid/README.md \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
